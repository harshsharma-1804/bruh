# BRUH — env/java.env
export JDK_HOME="$BRUH_HOME/runtimes/java"
if [ -f "$JDK_HOME/.default" ]; then
  _V=$(cat "$JDK_HOME/.default")
  _JHP=$(/usr/libexec/java_home -v "$_V" 2>/dev/null)
  if [ -n "$_JHP" ]; then
    export JAVA_HOME="$_JHP"
    export PATH=$(echo "$PATH" | tr ':' '\n' | grep -v '/Contents/Home/bin' | paste -sd ':' -)
    export PATH="$JAVA_HOME/bin:$PATH"
  fi
  unset _V _JHP
fi
