# BRUH — env/java.env
export JDK_HOME="$BRUH_HOME/runtimes/java"
if [ -f "$JDK_HOME/.default" ]; then
  _V=$(cat "$JDK_HOME/.default")
  ( [ -L "$JDK_HOME/v${_V}" ] || [ -d "$JDK_HOME/v${_V}" ] ) \
    && ln -sfn "$JDK_HOME/v${_V}" "$JDK_HOME/current" 2>/dev/null
  unset _V
fi
if [ -d "$JDK_HOME/current/bin" ]; then
  export JAVA_HOME="$JDK_HOME/current"
  export PATH="$JAVA_HOME/bin:$PATH"
fi
