# BRUH — env/node.env
export NODE_HOME="$BRUH_HOME/runtimes/node"
if [ -f "$NODE_HOME/.default" ]; then
  _V=$(cat "$NODE_HOME/.default")
  ( [ -L "$NODE_HOME/v${_V}" ] || [ -d "$NODE_HOME/v${_V}" ] ) \
    && ln -sfn "$NODE_HOME/v${_V}" "$NODE_HOME/current" 2>/dev/null
  unset _V
fi
[ -d "$NODE_HOME/current/bin" ] && export PATH="$NODE_HOME/current/bin:$PATH"
