# BRUH — env/go.env
export GO_HOME="$BRUH_HOME/runtimes/go"
if [ -f "$GO_HOME/.default" ]; then
  _V=$(cat "$GO_HOME/.default")
  ( [ -L "$GO_HOME/v${_V}" ] || [ -d "$GO_HOME/v${_V}" ] ) \
    && ln -sfn "$GO_HOME/v${_V}" "$GO_HOME/current" 2>/dev/null
  unset _V
fi
if [ -d "$GO_HOME/current" ]; then
  export GOROOT="$GO_HOME/current"
  [ -d "$GOROOT/bin" ] && export PATH="$GOROOT/bin:$PATH"
fi
export GOPATH="$HOME/go"
[ -d "$GOPATH/bin" ] && export PATH="$GOPATH/bin:$PATH"
