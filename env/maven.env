# BRUH — env/maven.env
export MAVEN_HOME="$BRUH_HOME/runtimes/maven"
if [ -f "$MAVEN_HOME/.default" ]; then
  _V=$(cat "$MAVEN_HOME/.default")
  ( [ -L "$MAVEN_HOME/v${_V}" ] || [ -d "$MAVEN_HOME/v${_V}" ] ) \
    && ln -sfn "$MAVEN_HOME/v${_V}" "$MAVEN_HOME/current" 2>/dev/null
  unset _V
fi
[ -d "$MAVEN_HOME/current/bin" ] && export PATH="$MAVEN_HOME/current/bin:$PATH"
