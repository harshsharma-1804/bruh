# BRUH — env/python.env
export PYTHON_HOME="$BRUH_HOME/runtimes/python"
if [ -f "$PYTHON_HOME/.default" ]; then
  _V=$(cat "$PYTHON_HOME/.default")
  ( [ -L "$PYTHON_HOME/v${_V}" ] || [ -d "$PYTHON_HOME/v${_V}" ] ) \
    && ln -sfn "$PYTHON_HOME/v${_V}" "$PYTHON_HOME/current" 2>/dev/null
  unset _V
fi
[ -d "$PYTHON_HOME/current/bin" ] && export PATH="$PYTHON_HOME/current/bin:$PATH"
