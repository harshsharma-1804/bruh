# =============================================================================
# BRUH — env/bruh.env
# Master loader — sourced at shell startup via ~/.zshrc / ~/.bashrc
#
# The installer writes these 3 lines to your shell config:
#   # Bruh — runtime environment manager
#   export BRUH_HOME="/opt/bruh"          ← actual install path
#   source "/opt/bruh/env/bruh.env"       ← this file
#
# BRUH_HOME is set by the export line above before this file is sourced.
# This file never hardcodes a path — it always uses $BRUH_HOME.
# =============================================================================

# Guard: if BRUH_HOME is not set, something is wrong
if [ -z "${BRUH_HOME:-}" ]; then
  echo "Bruh: BRUH_HOME is not set. Check your shell config." >&2
  return 1
fi

# Guard: if BRUH_HOME directory doesn't exist, Bruh may have been moved/removed
if [ ! -d "$BRUH_HOME" ]; then
  echo "Bruh: install directory not found at $BRUH_HOME" >&2
  return 1
fi

# Add bruh bin to PATH
export PATH="$BRUH_HOME/bin:$PATH"

# Load each runtime env file — only if that runtime has been initialised
# (detected via presence of a .default file written when a default is set)
[ -f "$BRUH_HOME/runtimes/node/.default" ]   && source "$BRUH_HOME/env/node.env"
[ -f "$BRUH_HOME/runtimes/java/.default" ]   && source "$BRUH_HOME/env/java.env"
[ -f "$BRUH_HOME/runtimes/python/.default" ] && source "$BRUH_HOME/env/python.env"
[ -f "$BRUH_HOME/runtimes/go/.default" ]     && source "$BRUH_HOME/env/go.env"
[ -f "$BRUH_HOME/runtimes/rust/.default" ]   && source "$BRUH_HOME/env/rust.env"
[ -f "$BRUH_HOME/runtimes/maven/.default" ]  && source "$BRUH_HOME/env/maven.env"

# Shell function wrapper — lets activate commands modify the current terminal session.
# When bruh runs an activate command it writes the required exports to .activate_env.
# This function sources that file immediately after the binary exits so the exports
# land in the current shell rather than dying with the subprocess.
bruh() {
  "$BRUH_HOME/bin/bruh" "$@"
  local _exit=$?
  local _env_file="$BRUH_HOME/.activate_env"
  if [ -f "$_env_file" ]; then
    # shellcheck source=/dev/null
    source "$_env_file"
    rm -f "$_env_file"
  fi
  return $_exit
}
