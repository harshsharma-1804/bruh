# -----------------------------------------------------------------------------
# bruh_search_prompt — shown when `bruh search` is called with no tool
# -----------------------------------------------------------------------------
bruh_search_prompt() {
  printf "\n${BRUH_BOLD}bruh search${BRUH_RESET} — what do you want to search?\n\n"
  printf "  %-10s  %s\n" "Tool" "Description"
  printf "  %-10s  %s\n" "─────────" "─────────────────────────────────────"
  printf "  %-10s  %s\n" "node"   "Available Node.js versions"
  printf "  %-10s  %s\n" "java"   "Available JDK distributions and providers"
  printf "  %-10s  %s\n" "python" "Available Python versions"
  printf "  %-10s  %s\n" "go"     "Available Go versions"
  printf "  %-10s  %s\n" "rust"   "Available Rust toolchains"
  printf "  %-10s  %s\n" "yarn"   "Available Yarn versions"
  printf "  %-10s  %s\n" "pnpm"   "Available pnpm versions"
  printf "  %-10s  %s\n" "maven"  "Available Maven versions"
  printf "\n"
  printf "  ${BRUH_BOLD}Usage:${BRUH_RESET}\n"
  printf "  ${BRUH_DIM}bruh search node${BRUH_RESET}\n"
  printf "  ${BRUH_DIM}bruh search java${BRUH_RESET}\n"
  printf "  ${BRUH_DIM}bruh search java 21      (filter to version 21)${BRUH_RESET}\n"
  printf "  ${BRUH_DIM}bruh search maven${BRUH_RESET}\n"
  printf "\n"
}

# -----------------------------------------------------------------------------
