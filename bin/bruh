#!/usr/bin/env bash
# =============================================================================
# BRUH — bin/bruh
# =============================================================================

set -euo pipefail

BRUH_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export BRUH_HOME="$(dirname "$BRUH_BIN")"

source "$BRUH_HOME/lib/core.sh"
source "$BRUH_HOME/lib/registry.sh"
source "$BRUH_HOME/lib/intent.sh"

bruh_require_jq
export HOMEBREW_PREFIX="$(bruh_homebrew_prefix)"

source "$BRUH_HOME/providers/node.sh"
source "$BRUH_HOME/providers/java.sh"
source "$BRUH_HOME/providers/python.sh"
source "$BRUH_HOME/providers/go.sh"
source "$BRUH_HOME/providers/rust.sh"
source "$BRUH_HOME/providers/yarn.sh"
source "$BRUH_HOME/providers/pnpm.sh"
source "$BRUH_HOME/providers/maven.sh"

# -----------------------------------------------------------------------------
# bruh_status_all
# -----------------------------------------------------------------------------
bruh_status_all() {
  printf "\n${BRUH_BOLD}  Bruh${BRUH_RESET} — runtime environment manager\n\n"
  bruh_divider
  local tools="node java python go rust yarn pnpm maven"
  for tool in $tools; do
    local current default
    current=$(registry_get "$tool" "current" 2>/dev/null || echo "")
    default=$(registry_get "$tool" "default" 2>/dev/null || echo "")
    if [ -n "$current" ] && [ "$current" != "null" ]; then
      printf "  ${BRUH_GREEN}%-8s${BRUH_RESET}  ${BRUH_BOLD}%s${BRUH_RESET}" "$tool" "$current"
      [ -n "$default" ] && [ "$default" != "null" ] && [ "$default" != "$current" ] \
        && printf "  ${BRUH_DIM}(default: %s)${BRUH_RESET}" "$default"
      printf "\n"
    else
      printf "  ${BRUH_DIM}%-8s  not set${BRUH_RESET}\n" "$tool"
    fi
  done
  printf "\n"
  printf "  ${BRUH_DIM}bruh help  for all commands${BRUH_RESET}\n\n"
}

# -----------------------------------------------------------------------------
# bruh_runtimes
# -----------------------------------------------------------------------------
bruh_runtimes() {
  printf "\n${BRUH_BOLD}  Runtimes & Tools${BRUH_RESET}\n\n"
  printf "  ${BRUH_BOLD}%-10s %-12s %-12s %-20s${BRUH_RESET}\n" "Tool" "Current" "Default" "Path"
  bruh_divider
  local tools="node java python go rust yarn pnpm maven"
  for tool in $tools; do
    local current default path_bin
    current=$(registry_get "$tool" "current" 2>/dev/null || echo "—")
    default=$(registry_get "$tool" "default" 2>/dev/null || echo "—")
    [ "$current" = "null" ] || [ -z "$current" ] && current="—"
    [ "$default" = "null" ] || [ -z "$default" ] && default="—"
    case "$tool" in
      node)   path_bin=$(command -v node    2>/dev/null || echo "not found") ;;
      java)   path_bin=$(command -v java    2>/dev/null || echo "not found") ;;
      python) path_bin=$(command -v python3 2>/dev/null || echo "not found") ;;
      go)     path_bin=$(command -v go      2>/dev/null || echo "not found") ;;
      rust)   path_bin=$(command -v rustc   2>/dev/null || echo "not found") ;;
      yarn)   path_bin=$(command -v yarn    2>/dev/null || echo "not found") ;;
      pnpm)   path_bin=$(command -v pnpm    2>/dev/null || echo "not found") ;;
      maven)  path_bin=$(command -v mvn     2>/dev/null || echo "not found") ;;
    esac
    printf "  %-10s %-12s %-12s %-20s\n" "$tool" "$current" "$default" "$path_bin"
  done
  printf "\n"
}

