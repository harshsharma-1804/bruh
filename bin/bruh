}

# -----------------------------------------------------------------------------
# bruh_goodbye
# -----------------------------------------------------------------------------
bruh_goodbye() {
  printf "\n${BRUH_BOLD}${BRUH_RED}  Bruh Uninstall${BRUH_RESET}\n\n"
  bruh_log "This will remove Bruh and everything it installed."
  bruh_log "Pre-existing runtimes you had before Bruh will ${BRUH_BOLD}not${BRUH_RESET} be touched."
  bruh_log ""
  printf "  Continue? [y/N] "
  read -r confirm
  case "$confirm" in
    [yY]|[yY][eE][sS]) ;;
    *) bruh_log "Aborted."; return 0 ;;
  esac
  printf "\n"
  bruh_info "Building removal plan from registry..."

  local java_versions
  java_versions=$(registry_list_bruh_installed "java" 2>/dev/null || echo "")
  if [ -n "$java_versions" ]; then
    bruh_info "Java JVM symlinks require sudo. Please authenticate:"
    sudo -v || bruh_die "sudo authentication failed"
  fi

  # Node
  registry_list_bruh_installed "node" 2>/dev/null | while read -r v; do
    [ -z "$v" ] && continue
    bruh_info "Removing Node $v..."
    brew uninstall "$(_node_formula "$v")" 2>/dev/null || bruh_warn "Could not uninstall Node $v"
    rm -f "$NODE_RUNTIME_HOME/v${v}" 2>/dev/null || true
  done

  # Java
  echo "$java_versions" | while read -r v; do
    [ -z "$v" ] && continue
    bruh_info "Removing Java $v..."
    brew uninstall "$(_java_formula "$v")" 2>/dev/null || bruh_warn "Could not uninstall Java $v"
    local jl; jl=$(_java_jvm_link "$v")
    ( [ -e "$jl" ] || [ -L "$jl" ] ) && sudo rm -f "$jl"
  done

  # Python
  registry_list_bruh_installed "python" 2>/dev/null | while read -r v; do
    [ -z "$v" ] && continue
    bruh_info "Removing Python $v..."
    brew uninstall "$(_python_formula "$v")" 2>/dev/null || bruh_warn "Could not uninstall Python $v"
    rm -f "$PYTHON_RUNTIME_HOME/v${v}" 2>/dev/null || true
  done

  # Go
  registry_list_bruh_installed "go" 2>/dev/null | while read -r v; do
    [ -z "$v" ] && continue
    bruh_info "Removing Go $v..."
    brew uninstall "$(_go_formula "$v")" 2>/dev/null || bruh_warn "Could not uninstall Go $v"
    rm -f "$GO_RUNTIME_HOME/v${v}" 2>/dev/null || true
  done

  # Rust
  registry_list_bruh_installed "rust" 2>/dev/null | while read -r v; do
    [ -z "$v" ] && continue
    bruh_info "Removing Rust $v..."
    rustup toolchain uninstall "$v" 2>/dev/null || bruh_warn "Could not uninstall Rust $v"
  done

  # Yarn
  local yarn_exact; yarn_exact=$(registry_get_exact "yarn" 2>/dev/null || echo "")
  if [ -n "$yarn_exact" ] && registry_list_bruh_installed "yarn" 2>/dev/null | grep -q .; then
    bruh_info "Removing Yarn $yarn_exact from corepack..."
    corepack remove "yarn@${yarn_exact}" 2>/dev/null || bruh_warn "Could not remove Yarn"
  fi

  # pnpm
  local pnpm_exact; pnpm_exact=$(registry_get_exact "pnpm" 2>/dev/null || echo "")
  if [ -n "$pnpm_exact" ] && registry_list_bruh_installed "pnpm" 2>/dev/null | grep -q .; then
    bruh_info "Removing pnpm $pnpm_exact from corepack..."
    corepack remove "pnpm@${pnpm_exact}" 2>/dev/null || bruh_warn "Could not remove pnpm"
  fi

  # Maven
  registry_list_bruh_installed "maven" 2>/dev/null | while read -r v; do
    [ -z "$v" ] && continue
    bruh_info "Removing Maven $v..."
    brew uninstall "$(_maven_formula "$v")" 2>/dev/null || bruh_warn "Could not uninstall Maven $v"
    rm -f "$MAVEN_RUNTIME_HOME/v${v}" 2>/dev/null || true
  done

  # Shell integration — strip all 3 lines: comment + BRUH_HOME export + source
  bruh_info "Removing shell integration..."
  local _bruh_escaped
  _bruh_escaped=$(printf '%s\n' "$BRUH_HOME" | sed 's/[[\.*^$()+?{|]/\\&/g')
  for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile"; do
    if [ -f "$rc" ] && grep -q 'bruh.env' "$rc" 2>/dev/null; then
      grep -v '# Bruh — runtime environment manager' "$rc" > "${rc}.bruh_tmp" \
        && mv "${rc}.bruh_tmp" "$rc"
      grep -v 'export BRUH_HOME=' "$rc" > "${rc}.bruh_tmp" \
        && mv "${rc}.bruh_tmp" "$rc"
      grep -v 'source.*bruh.env' "$rc" > "${rc}.bruh_tmp" \
        && mv "${rc}.bruh_tmp" "$rc"
      bruh_ok "Removed from $rc"
    fi
  done

  # Unset env vars in current session
  bruh_info "Clearing environment variables..."
  local _bruh_home_save="$BRUH_HOME"
  unset BRUH_HOME NODE_HOME JAVA_HOME PYTHON_HOME GOROOT GOPATH CARGO_HOME RUSTUP_HOME 2>/dev/null || true
  export PATH=$(echo "$PATH" | tr ':' '\n' | grep -v "$_bruh_home_save" | paste -sd ':' -)

  # Remove Bruh directory — uses the saved path since BRUH_HOME is now unset
  bruh_info "Removing ${_bruh_home_save}..."
  rm -rf "$_bruh_home_save"

  printf "\n  ${BRUH_BOLD}${BRUH_GREEN}Bruh is gone. Your system is clean.${BRUH_RESET}\n\n"
}

# =============================================================================
# MAIN DISPATCH
# =============================================================================
if [ $# -eq 0 ]; then
  bruh_status_all; exit 0
fi

intent=$(bruh_parse_intent "$@")
action=$(echo "$intent" | cut -d'|' -f1)
tool=$(echo "$intent"   | cut -d'|' -f2)
version=$(echo "$intent" | cut -d'|' -f3)

case "$action" in
  help)     bruh_help;     exit 0 ;;
  runtimes) bruh_runtimes; exit 0 ;;
  goodbye)  bruh_goodbye;  exit 0 ;;
  status)
    if [ "$tool" = "all" ] || [ -z "$tool" ]; then
      bruh_status_all; exit 0
    fi
    ;;
  search)
    if [ "$tool" = "all" ] || [ -z "$tool" ]; then
      bruh_search_prompt; exit 0
    fi
    "${tool}_search" "$version"
    exit 0
    ;;
  lookup)
    if [ "$tool" = "all" ] || [ -z "$tool" ]; then
      bruh_lookup_all; exit 0
    fi
    ;;
esac

[ -z "$tool" ] && bruh_die "Could not determine tool from: $*"

case "$action" in
  install_or_activate) "${tool}_install_or_activate" "$version" ;;
  install)             "${tool}_install"             "$version" ;;
  activate)            "${tool}_activate"            "$version" ;;
  remove)              "${tool}_remove"              "$version" ;;
  set_default)         "${tool}_set_default"         "$version" ;;
  status)              "${tool}_status"                         ;;
  lookup)              "${tool}_lookup"                         ;;
  locate)              "${tool}_locate"                         ;;
  update)              "${tool}_update"              "$version" ;;
  set_project)         "${tool}_set_project"         "$version" ;;
  search)              "${tool}_search"              "$version" ;;
  latest)              "${tool}_install_or_activate" "latest"   ;;
  stable)              "${tool}_install_or_activate" "stable"   ;;
  classic)             "${tool}_install_or_activate" "classic"  ;;
  berry)               "${tool}_install_or_activate" "berry"    ;;
  *)
    bruh_err "Unknown action: '$action'"
    bruh_log "Run: bruh help"
    exit 1 ;;
esac
